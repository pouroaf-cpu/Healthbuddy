      const cats = document.querySelectorAll('.ib-guides-cat');

      cats.forEach(cat => {
        const btn = cat.querySelector('.ib-guides-cat-toggle');
        const panel = cat.querySelector('.ib-guides-cat-panel');
        if (!btn || !panel) return;

        btn.addEventListener('click', () => {
          const isOpen = cat.classList.contains('is-open');

          cats.forEach(other => {
            const ob = other.querySelector('.ib-guides-cat-toggle');
            const op = other.querySelector('.ib-guides-cat-panel');
            if (!ob || !op) return;
            other.classList.remove('is-open');
            ob.setAttribute('aria-expanded', 'false');
            op.hidden = true;
          });

          if (!isOpen) {
            cat.classList.add('is-open');
            btn.setAttribute('aria-expanded', 'true');
            panel.hidden = false;
          }
        });
      });
    });

    // Scroll to top button behaviour
    document.addEventListener("DOMContentLoaded", () => {
      const btn = document.getElementById("ib-scroll-top");

      function toggleButton() {
        if (window.innerWidth <= 980) {
          if (window.scrollY > 180) {
            btn.classList.add("visible");
          } else {
            btn.classList.remove("visible");
          }
        } else {
          btn.classList.remove("visible");
        }
      }

      window.addEventListener("scroll", toggleButton, { passive: true });
      window.addEventListener("resize", toggleButton);

      btn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });

      toggleButton();
    });
  </script>
</body>
</html>



